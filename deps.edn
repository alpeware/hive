{:paths ["src" "resources" "dev"]
 :deps {org.clojure/clojure {:mvn/version "1.12.4"}
        org.clojure/core.async {:mvn/version "1.9.829-alpha2"}
        org.clojure/data.json {:mvn/version "2.5.1"}
        org.clojure/data.fressian {:mvn/version "1.1.0"}
        alpeware/clj-fressian {:git/url "https://bitecho.org/git/clj-fressian.git"
                               :git/sha "4c56c12c8f94efed4324c8f0a4ed340337bdbc54"}
        alpeware/clj-datachannel {:local/root "../clj-datachannel"}
        alpeware/bitecho {:local/root "../bitecho"}
        alpeware/mealy {:local/root "../mealy"}
        alpeware/clj-einsum {:local/root "../clj-einsum"}
        elle/elle {:mvn/version "0.2.1"}
        spootnik/unilog {:mvn/version "0.7.31"}
        knossos/knossos {:mvn/version "0.3.8"}}
 :jvm-opts ["-XX:+IgnoreUnrecognizedVMOptions"
            "--sun-misc-unsafe-memory-access=allow"
            "--enable-native-access=ALL-UNNAMED"
            "--add-modules=jdk.incubator.vector"
            "--add-exports=java.base/sun.security.tools.keytool=ALL-UNNAMED"
            "--add-exports=java.base/sun.security.x509=ALL-UNNAMED"
            "-Xmx16g"]
 :aliases {:run {:jvm-opts ["-XX:+IgnoreUnrecognizedVMOptions"
                            "--sun-misc-unsafe-memory-access=allow"
                            "--enable-native-access=ALL-UNNAMED"
                            "--add-modules=jdk.incubator.vector"
                            "--add-exports=java.base/sun.security.tools.keytool=ALL-UNNAMED"
                            "--add-exports=java.base/sun.security.x509=ALL-UNNAMED"
                            "-Xmx16g"]
                 :main-opts ["-m" "bitecho.hive.main"]}
           :test {:extra-paths ["test"]
                  :extra-deps {org.clojure/test.check {:mvn/version "1.1.1"}}
                  :jvm-opts ["-XX:+IgnoreUnrecognizedVMOptions"
                             "--sun-misc-unsafe-memory-access=allow"
                             "--enable-native-access=ALL-UNNAMED"
                             "--add-modules=jdk.incubator.vector"
                             "--add-exports=java.base/sun.security.tools.keytool=ALL-UNNAMED"
                             "--add-exports=java.base/sun.security.x509=ALL-UNNAMED"
                             "-Xmx16g"]
                  :main-opts ["-m" "bitecho.hive.test-runner"]}
           :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2026.01.19"}
                                 org.clojure/test.check {:mvn/version "1.1.1"}}
                  :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"]}
           :format {:replace-deps {dev.weavejester/cljfmt {:mvn/version "0.16.1"}}
                    :main-opts ["-m" "cljfmt.main" "fix" "src" "test"]}}}
